# Salin file ini menjadi ".env" lalu sesuaikan.
# Ganti PASSWORD_ANDA dengan password user "postgres" saat install PostgreSQL.
DATABASE_URL="postgresql://postgres:PASSWORD_ANDA@localhost:5432/monitoring?schema=public"

# String acak minimal 32 karakter untuk mengamankan login (bebas, asal panjang & rahasia)
SESSION_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter-xyz"
