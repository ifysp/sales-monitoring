// Skema database SWIT Monitoring v3
// Gabungan: SRS Sales Monitoring (Site, Alat USG, PC, ViewPoint 6, Tricefy, PO, Invoice)
//         + alur dokumen PO: PO diterima → Invoice & BA → Tukar faktur → Penagihan → Clear.
// Harga hanya satu: nilai final di invoice. Package disiapkan untuk pengembangan berikutnya.
// Ubah file ini lalu jalankan `npx prisma migrate dev --name <nama_perubahan>`.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════ PENGGUNA & AUDIT ═══════════════════════════

enum Role {
  ADMIN // boleh lihat, tambah, ubah, hapus semua data
  VIEWER // hanya lihat (disiapkan untuk pengguna baru nanti)
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(ADMIN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  auditLogs    AuditLog[]
  attachments  Attachment[]

  @@map("users")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // CREATE, UPDATE, DELETE, LOGIN
  entity    String // Customer, PurchaseOrder, Vp6Installation, ...
  entityId  Int?
  summary   String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════ MASTER DATA ═══════════════════════════

enum Product {
  VIEWPOINT
  TRICEFY
}

model Package {
  id                   Int                   @id @default(autoincrement())
  product              Product
  name                 String
  unit                 String? // studies, scanner, lisensi
  active               Boolean               @default(true)
  vp6Installations     Vp6Installation[]
  tricefySubscriptions TricefySubscription[]

  @@map("packages")
}

model MachineModel {
  id      Int      @id @default(autoincrement())
  brand   String // GE
  model   String // Voluson P18, Logiq E10s, ...
  active  Boolean  @default(true)
  devices Device[]

  @@map("machine_models")
}

// ═══════════════════════════ CUSTOMER (= SITE) ═══════════════════════════

enum CustomerType {
  RUMAH_SAKIT
  KLINIK
  DOKTER
  LAINNYA
}

// Satu RS/klinik/dokter = satu Site ID GE Healthcare (BR-01)
model Customer {
  id               Int               @id @default(autoincrement())
  name             String
  type             CustomerType
  geSiteId         String?           @unique // Site ID dari GE Healthcare (boleh kosong untuk customer Tricefy saja)
  city             String?
  address          String?
  contactName      String? // nama kontak / dokter
  phone            String?
  email            String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  devices          Device[]
  pcs              Pc[]
  orders           PurchaseOrder[]
  vp6Installations Vp6Installation[]
  tricefyAccounts  TricefyAccount[]
  techNotes        TechNote[]
  errorLogs        ErrorLog[]

  @@map("customers")
}

// ═══════════════════════════ ALAT USG & PC ═══════════════════════════

model Device {
  id                   Int                         @id @default(autoincrement())
  customerId           Int
  serialNumber         String                      @unique
  machineModelId       Int?
  notes                String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deletedAt            DateTime?
  customer             Customer                    @relation(fields: [customerId], references: [id])
  machineModel         MachineModel?               @relation(fields: [machineModelId], references: [id])
  vp6Installations     Vp6InstallationDevice[]
  tricefySubscriptions TricefySubscriptionDevice[]
  errorLogs            ErrorLog[]

  @@index([customerId])
  @@map("devices")
}

enum PcSource {
  COMPANY_RECOMMENDED // rekomendasi perusahaan
  CUSTOMER_OWNED // milik dokter/RS
}

enum PcRole {
  SERVER_CLIENT // klinik kecil: satu PC jadi server sekaligus client
  SERVER
  CLIENT
}

model Pc {
  id            Int                 @id @default(autoincrement())
  customerId    Int
  hostname      String?
  source        PcSource
  role          PcRole
  cpu           String?
  ram           String?
  storage       String?
  vga           String?
  os            String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  customer      Customer            @relation(fields: [customerId], references: [id])
  installations Vp6InstallationPc[]

  @@index([customerId])
  @@map("pcs")
}

// ═══════════════════════════ PURCHASE ORDER & INVOICE ═══════════════════════════

enum PaymentMethod {
  CASH
  CICILAN
}

model PurchaseOrder {
  id                   Int                   @id @default(autoincrement())
  customerId           Int
  poNumber             String                @unique
  poDate               DateTime              @db.Date // tanggal PO diterima dari customer
  paymentMethod        PaymentMethod         @default(CASH)
  // Langkah 2: invoice & berita acara (harga final ada di sini)
  invoiceNumber        String?               @unique
  invoiceDate          DateTime?             @db.Date
  finalAmount          Decimal?              @db.Decimal(15, 2)
  baDate               DateTime?             @db.Date
  // Langkah 3: tukar faktur
  tukarFakturDate      DateTime?             @db.Date
  notes                String? // diskon, negosiasi, deal khusus
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  customer             Customer              @relation(fields: [customerId], references: [id])
  payments             Payment[]
  attachments          Attachment[]
  vp6Installations     Vp6Installation[]
  tricefySubscriptions TricefySubscription[]

  @@index([customerId])
  @@map("purchase_orders")
}

// Penagihan per termin. Cash = 1 termin, cicilan = beberapa termin dari satu invoice.
model Payment {
  id          Int           @id @default(autoincrement())
  orderId     Int
  sequence    Int // termin ke-
  amount      Decimal       @db.Decimal(15, 2)
  dueDate     DateTime      @db.Date
  paidAt      DateTime?     @db.Date
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@unique([orderId, sequence])
  @@index([dueDate])
  @@map("payments")
}

// ═══════════════════════════ VIEWPOINT 6 ═══════════════════════════

model Vp6Installation {
  id             Int                     @id @default(autoincrement())
  customerId     Int
  orderId        Int?
  packageId      Int?
  licenseQty     Int?
  installDate    DateTime                @db.Date
  currentVersion String
  apps           String? // teks dulu, nanti bisa jadi pilihan ganda (FR-05.6)
  specialConfig  String? // hanya bila ada permintaan khusus user/dokter (BR-07)
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  customer       Customer                @relation(fields: [customerId], references: [id])
  order          PurchaseOrder?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  package        Package?                @relation(fields: [packageId], references: [id])
  devices        Vp6InstallationDevice[]
  pcs            Vp6InstallationPc[]
  versionHistory Vp6VersionHistory[]

  @@index([customerId])
  @@index([installDate])
  @@map("vp6_installations")
}

model Vp6InstallationDevice {
  installationId Int
  deviceId       Int
  installation   Vp6Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  device         Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([installationId, deviceId])
  @@map("vp6_installation_devices")
}

model Vp6InstallationPc {
  installationId Int
  pcId           Int
  installation   Vp6Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  pc             Pc              @relation(fields: [pcId], references: [id], onDelete: Cascade)

  @@id([installationId, pcId])
  @@map("vp6_installation_pcs")
}

model Vp6VersionHistory {
  id             Int             @id @default(autoincrement())
  installationId Int
  fromVersion    String?
  toVersion      String
  changedDate    DateTime        @db.Date
  notes          String?
  createdAt      DateTime        @default(now())
  installation   Vp6Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId])
  @@map("vp6_version_history")
}

// ═══════════════════════════ TRICEFY ═══════════════════════════

model TricefyAccount {
  id            Int                   @id @default(autoincrement())
  customerId    Int
  tricefyId     String                @unique // ID per akun (BR-05)
  accountEmail  String?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  customer      Customer              @relation(fields: [customerId], references: [id])
  subscriptions TricefySubscription[]

  @@index([customerId])
  @@map("tricefy_accounts")
}

// Perpanjangan = langganan baru pada akun yang sama (FR-06.7)
model TricefySubscription {
  id             Int                         @id @default(autoincrement())
  accountId      Int
  orderId        Int?
  packageId      Int?
  quantity       Int? // jumlah studies / scanner (kosong = unlimited)
  installDate    DateTime?                   @db.Date
  contractDate   DateTime?                   @db.Date
  activationDate DateTime                    @db.Date
  endDate        DateTime                    @db.Date // default aktivasi + 3 tahun (BR-04)
  notes          String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  deletedAt      DateTime?
  account        TricefyAccount              @relation(fields: [accountId], references: [id])
  order          PurchaseOrder?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  package        Package?                    @relation(fields: [packageId], references: [id])
  devices        TricefySubscriptionDevice[]

  @@index([accountId])
  @@index([endDate])
  @@map("tricefy_subscriptions")
}

model TricefySubscriptionDevice {
  subscriptionId Int
  deviceId       Int
  subscription   TricefySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  device         Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, deviceId])
  @@map("tricefy_subscription_devices")
}

// ═══════════════════════════ CATATAN TEKNIS & LAMPIRAN ═══════════════════════════

enum TechNoteKind {
  INTEGRASI
  PREFERENSI_DOKTER
  QUICK_REPORT
  JURNAL_GRAFIK
  LAINNYA
}

model TechNote {
  id         Int          @id @default(autoincrement())
  customerId Int
  kind       TechNoteKind
  title      String
  content    String
  updatedAt  DateTime     @updatedAt
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("tech_notes")
}

model ErrorLog {
  id          Int          @id @default(autoincrement())
  customerId  Int
  deviceId    Int?
  occurredAt  DateTime     @db.Date
  symptom     String
  cause       String?
  solution    String?
  createdAt   DateTime     @default(now())
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([customerId])
  @@map("error_logs")
}

enum AttachmentKind {
  PO
  INVOICE
  BERITA_ACARA
  TANDA_TERIMA // tanda terima tukar faktur
  FAKTUR // faktur pajak (opsional)
  BUKTI_BAYAR
  ERROR
  LAINNYA
}

model Attachment {
  id           Int            @id @default(autoincrement())
  orderId      Int?
  paymentId    Int?
  errorLogId   Int?
  kind         AttachmentKind @default(LAINNYA)
  fileName     String
  storedName   String         @unique
  mimeType     String
  size         Int
  uploadedById Int?
  createdAt    DateTime       @default(now())
  order        PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment      Payment?       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  errorLog     ErrorLog?      @relation(fields: [errorLogId], references: [id], onDelete: Cascade)
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("attachments")
}
